{
  "Comment": "AutoPulse collisions pipeline (daily): NYC API -> Bronze -> Silver -> Gold, then validate the data lake. Snowpipe loads Gold into Snowflake by itself.",
  "StartAt": "IngestCollisionsToBronze",
  "States": {
    "IngestCollisionsToBronze": {
      "Type": "Task",
      "Comment": "Run Glue job autopulse-collisions-ingestion and wait until it finishes",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "autopulse-collisions-ingestion"
      },
      "ResultSelector": {
        "JobRunId.$": "$.Id",
        "State.$": "$.JobRunState",
        "ExecutionTimeSeconds.$": "$.ExecutionTime"
      },
      "ResultPath": "$.ingestion",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 120,
          "MaxAttempts": 1,
          "BackoffRate": 1
        }
      ],
      "Next": "CollisionsBronzeToSilver"
    },
    "CollisionsBronzeToSilver": {
      "Type": "Task",
      "Comment": "Run Glue job autopulse-collisions-silver and wait until it finishes",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "autopulse-collisions-silver"
      },
      "ResultSelector": {
        "JobRunId.$": "$.Id",
        "State.$": "$.JobRunState",
        "ExecutionTimeSeconds.$": "$.ExecutionTime"
      },
      "ResultPath": "$.silver",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 120,
          "MaxAttempts": 1,
          "BackoffRate": 1
        }
      ],
      "Next": "CollisionsSilverToGold"
    },
    "CollisionsSilverToGold": {
      "Type": "Task",
      "Comment": "Run Glue job autopulse-collisions-gold and wait until it finishes",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "autopulse-collisions-gold"
      },
      "ResultSelector": {
        "JobRunId.$": "$.Id",
        "State.$": "$.JobRunState",
        "ExecutionTimeSeconds.$": "$.ExecutionTime"
      },
      "ResultPath": "$.gold",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 120,
          "MaxAttempts": 1,
          "BackoffRate": 1
        }
      ],
      "Next": "ValidateDataLake"
    },
    "ValidateDataLake": {
      "Type": "Task",
      "Comment": "Check the S3 layers against each other (Lambda autopulse-validate-data-lake)",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "autopulse-validate-data-lake",
        "Payload": {
          "pipeline": "collisions",
          "bronze_cutoff.$": "$$.Execution.StartTime"
        }
      },
      "ResultSelector": {
        "passed.$": "$.Payload.passed",
        "results.$": "$.Payload.results"
      },
      "ResultPath": "$.validation",
      "End": true
    }
  }
}