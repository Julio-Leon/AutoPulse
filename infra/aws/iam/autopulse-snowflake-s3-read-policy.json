{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SnowflakeReadSilverAndGold",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::BUCKET_NAME/silver/*",
        "arn:aws:s3:::BUCKET_NAME/gold/*"
      ]
    },
    {
      "Sid": "SnowflakeListSilverAndGold",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "silver/*",
            "gold/*"
          ]
        }
      }
    }
  ]
}
