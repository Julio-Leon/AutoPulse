{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeCollisionsIngestion",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:AWS_REGION_NAME:AWS_ACCOUNT_ID:function:autopulse-collisions-ingestion"
    },
    {
      "Sid": "RunAutoPulseGlueJobs",
      "Effect": "Allow",
      "Action": ["glue:StartJobRun", "glue:GetJobRun", "glue:GetJobRuns", "glue:BatchStopJobRun", "glue:GetJob"],
      "Resource": "arn:aws:glue:AWS_REGION_NAME:AWS_ACCOUNT_ID:job/autopulse-*"
    },
    {
      "Sid": "ReadGlueJobLogs",
      "Effect": "Allow",
      "Action": ["logs:GetLogEvents", "logs:DescribeLogStreams", "logs:FilterLogEvents"],
      "Resource": "arn:aws:logs:AWS_REGION_NAME:AWS_ACCOUNT_ID:log-group:/aws-glue/*"
    }
  ]
}
