# Copy this file to .env and adjust. .env is git-ignored; never commit secrets.

# ---------- Storage ----------
# Leave DATA_ROOT unset (or commented) to use the local ./data folder.
# Set it to your bucket to read/write the data lake on S3:
# DATA_ROOT=s3://autopulse-data-lake-<your-suffix>
# CHECKPOINT_ROOT=s3://autopulse-data-lake-<your-suffix>/_checkpoints
AWS_REGION=us-east-1

# Local development: use your own AWS login (see infra/aws/README.md step 4a).
# If you signed in with `aws configure sso`, name the profile here:
# AWS_PROFILE=autopulse
# On EC2, leave all AWS credential settings unset; the instance role is used.

# ---------- Kafka / streaming ----------
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
VEHICLE_TELEMETRY_TOPIC=vehicle.telemetry.raw
TRAFFIC_INCIDENTS_TOPIC=traffic.incidents.raw
STREAM_TRIGGER_INTERVAL=1 minute
SIMULATOR_NUMBER_OF_VEHICLES=10
SIMULATOR_PUBLISH_INTERVAL_SECONDS=5

# ---------- NYC Open Data ----------
# Optional: free app token from data.cityofnewyork.us (raises rate limits)
# NYC_OPEN_DATA_APP_TOKEN=

# ---------- Fleet rules ----------
MAINTENANCE_INTERVAL_MILES=5000
MAINTENANCE_DUE_WINDOW_MILES=250

# ---------- Spark ----------
SPARK_MASTER=local[*]
# Override only if your PySpark build uses a different Hadoop version.
# HADOOP_AWS_VERSION=3.3.4
