{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListSilverFolder",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::autopulse-julio-leon",
      "Condition": { "StringLike": { "s3:prefix": ["silver/*"] } }
    },
    {
      "Sid": "ReadSilverFiles",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::autopulse-julio-leon/silver/*"
    }
  ]
}
