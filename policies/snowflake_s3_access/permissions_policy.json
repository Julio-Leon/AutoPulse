{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FindTheBucket",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::autopulse-julio-leon"
    },
    {
      "Sid": "ListGoldFolder",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::autopulse-julio-leon",
      "Condition": { "StringLike": { "s3:prefix": ["gold/*"] } }
    },
    {
      "Sid": "ReadGoldFiles",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::autopulse-julio-leon/gold/*"
    }
  ]
}
