{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDataLakeBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::autopulse-julio-leon"
    },
    {
      "Sid": "IngestionWritesBronzeCollisions",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::autopulse-julio-leon/bronze/collisions/*"
    },
    {
      "Sid": "TransformationsReadBronze",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::autopulse-julio-leon/bronze/*"
    },
    {
      "Sid": "TransformationsWriteSilverAndQuarantine",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::autopulse-julio-leon/silver/*",
        "arn:aws:s3:::autopulse-julio-leon/quarantine/*"
      ]
    }
  ]
}
