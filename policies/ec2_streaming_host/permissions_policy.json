{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDataLakeBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::autopulse-julio-leon"
    },
    {
      "Sid": "ReadDeployedCode",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::autopulse-julio-leon/deployment/*"
    },
    {
      "Sid": "CheckParentFolders",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::autopulse-julio-leon/bronze",
        "arn:aws:s3:::autopulse-julio-leon/bronze/",
        "arn:aws:s3:::autopulse-julio-leon/bronze/vehicle_telemetry",
        "arn:aws:s3:::autopulse-julio-leon/_checkpoints"
      ]
    },
    {
      "Sid": "StreamTelemetryToBronzeWithCheckpoints",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::autopulse-julio-leon/bronze/vehicle_telemetry/*",
        "arn:aws:s3:::autopulse-julio-leon/_checkpoints/*"
      ]
    }
  ]
}