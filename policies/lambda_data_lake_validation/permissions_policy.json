{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheDataLake",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::autopulse-julio-leon"
    },
    {
      "Sid": "ReadParquetFooters",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::autopulse-julio-leon/bronze/*",
        "arn:aws:s3:::autopulse-julio-leon/silver/*",
        "arn:aws:s3:::autopulse-julio-leon/quarantine/*",
        "arn:aws:s3:::autopulse-julio-leon/gold/*"
      ]
    }
  ]
}