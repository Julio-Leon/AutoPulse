{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunAndWatchAutoPulseGlueJobs",
      "Effect": "Allow",
      "Action": [
        "glue:StartJobRun",
        "glue:GetJobRun",
        "glue:GetJobRuns",
        "glue:BatchStopJobRun"
      ],
      "Resource": "arn:aws:glue:us-east-1:866934333672:job/autopulse-*"
    },
    {
      "Sid": "CallTheValidationLambda",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": [
        "arn:aws:lambda:us-east-1:866934333672:function:autopulse-validate-data-lake",
        "arn:aws:lambda:us-east-1:866934333672:function:autopulse-validate-data-lake:*"
      ]
    }
  ]
}